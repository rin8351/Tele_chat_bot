# Reference list of secrets used by this project.
# Runtime config today is data/data.json (copy from data/data.json.example).
# Do not commit a filled .env file.

# Telethon user client
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+1234567890
TELEGRAM_USERNAME=
TELEGRAM_2FA_PASSWORD=

# Source group (display name as seen in Telegram dialogs)
TELEGRAM_SOURCE_GROUP_NAME=

# Numeric id fragment for https://t.me/c/{id}/{message_id} links
TELEGRAM_CHAT_ORIGIN_ID=

# Operator notices (startup / shutdown) + primary ACL admin user id
TELEGRAM_ADMIN_CHAT_ID=

# Optional extra admin user ids (comma-separated), same role as ALLOWED_ADMIN_IDS in data.json
TELEGRAM_ALLOWED_ADMIN_IDS=

# Where digests are posted (bot must be allowed to write here)
TELEGRAM_DIGEST_CHAT_ID=

# Aiogram bot
TELEGRAM_BOT_TOKEN=

# OpenAI
OPENAI_API_KEY=
