    "YOUR_PRIVATE_CHANNEL": "Name of the channel/group to monitor",
    "chat_origin_mess": "CHAT_ID_FOR_LINKS",
    "YOUR_ADMIN_CHAT_ID": "123456789",
    "ALLOWED_ADMIN_IDS": [],
    "CHANNEL_to_send": "CHANNEL_ID_TO_SEND_SUMMARIES",
    "TELEGRAM_BOT_TOKEN": "YOUR_BOT_TOKEN_FROM_BOTFATHER",
    "OPENAI_API_KEY": "YOUR_OPENAI_API_KEY",
    "default_prompt": "You summarize Telegram chat messages. Keep message ids at the start of each line. Do not invent facts. Keep domain jargon (tickers, slang) when it carries meaning.",
    "default_style": "XYZ has been dumped into the order book for a second day. Whales claimed the airdrop and are selling into spot. DAO snapshot rumor — no proof.",
    "summarization_prompt": "Summarize the text. Do not draw conclusions. Keep the message id at the start of each line. If the same fact appears under several message ids, keep only the first id. Put external links at the end of the line. Remove filler lines that only say there is no useful information, that people are arguing, or chatting unconstructively — but if the whole summary has no useful information, you may say that once. Style example (do not copy these lines into the summary): {style}\nText to summarize:\n{text}"
}
